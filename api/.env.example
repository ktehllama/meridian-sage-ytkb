# Sage Chat — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Absolute path to the ChromaDB vector store directory (contains chroma.sqlite3)
CHROMA_DB_PATH=C:/full/path/to/yc_vectors

# ChromaDB collection name (must match what pipeline.py used when embedding)
CHROMA_COLLECTION=transcripts

# ── SQLite ────────────────────────────────────────────────────────────────────
# Absolute path to the knowledge.db SQLite database created by pipeline.py
SQLITE_DB_PATH=C:/full/path/to/knowledge.db

# ── Google Cloud / Vertex AI ─────────────────────────────────────────────────
# GCP project number (not project ID string)
GCP_PROJECT=YOUR_GCP_PROJECT_NUMBER

# Vertex AI region — must support Gemini 2.0 Flash
GCP_LOCATION=us-central1

# Gemini model to use for query expansion and synthesis
GEMINI_MODEL=gemini-2.0-flash

# ── Auth note ─────────────────────────────────────────────────────────────────
# Vertex AI uses Application Default Credentials (ADC).
# Run once before starting the server:
#   gcloud auth application-default login
# No API key file needed.
