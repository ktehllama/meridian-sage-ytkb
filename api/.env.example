# Backend env vars — copy to .env and fill in your values

# Path to the ChromaDB vector store directory
CHROMA_DB_PATH=/path/to/yc_vectors

# Collection name (must match what pipeline.py used when embedding)
CHROMA_COLLECTION=transcripts

# Path to knowledge.db created by pipeline.py
SQLITE_DB_PATH=/path/to/knowledge.db

# GCP project number (digits, not the string ID) — find it in the GCP console
GCP_PROJECT=YOUR_GCP_PROJECT_NUMBER

# Vertex AI region
GCP_LOCATION=us-central1

# Gemini model
GEMINI_MODEL=gemini-2.0-flash

# Auth: Vertex AI uses Application Default Credentials, no API key needed.
# Run once: gcloud auth application-default login
